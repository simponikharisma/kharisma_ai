# Environment Variables for KHARISMA AI
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional text-generation fallback through OpenRouter (requires account credits)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Single-admin login (set real values in your local .env and Vercel Environment Variables)
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SECRET=

# Server Port (default 3003)
PORT=3003

# AI model and request timeout
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=90000
PORT=3003
