# Environment Variables for KHARISMA AI
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional text-generation fallback through OpenRouter (requires account credits)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Single-admin login (set real values in your local .env and Vercel Environment Variables)
ADMIN_USERNAME=
ADMIN_PASSWORD=
AUTH_SECRET=

# AI model and request timeout
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=90000

# Optional reliability tuning (defaults shown). Total budget stays GEMINI_TIMEOUT_MS.
AI_ATTEMPT_TIMEOUT_MS=60000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=800

# Optional in-memory cache tuning (defaults shown; voice cache dibatasi maksimal 50 entri)
AI_CACHE_TTL_MS=1800000
AI_CACHE_MAX_ENTRIES=200

# Optional: override OpenRouter endpoint (useful for integration tests/self-hosting)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: override Gemini endpoint (proxy/self-hosting; defaults to Google's API)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Server port (default 3003)
PORT=3003
